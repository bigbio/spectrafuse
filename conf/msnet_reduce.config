/*
    ID-based reduction of identified projects (e.g. MSNet): cluster every PSM of a project per charge with
    MaRaCluster, then write one reduced qpx psm file per project (pyspectrafuse reduce-psm). The cluster DB
    and MSP library are not built. Put each project's .psm.parquet file(s) (parts allowed) in
    <parquet_dir>/<project>/.
*/
params {
    skip_instrument = true
    skip_cluster_db = true
    skip_msp        = true
    reduce_psm      = true
    // one peptide seen ~42k times (PXD010154 haemoglobin) drives MaRaCluster to 60 GB; cap what is clustered
    cluster_max_psms_per_pfz = 2000
}

process {
    withName: '.*PARQUET_TO_DAT' {
        memory = 32.GB
    }
    // Dense m/z windows of large projects (PXD010154 charge 3, 3.2M spectra) need > 48 GB in MaRaCluster's
    // clustering step; double the memory on each retry.
    withName: '.*RUN_MARACLUSTER_DAT' {
        memory     = { [16.GB * (2 ** (task.attempt - 1)), 256.GB].min() }
        maxRetries = 4
    }
    withName: '.*MERGE_MZ_WINDOWS' {
        memory = { 64.GB * task.attempt }
        cpus   = 8
    }
    withName: '.*REDUCE_PSM' {
        memory = { 120.GB * task.attempt }
        cpus   = 16
        time   = { 24.h * task.attempt }
        // a failed input check is deterministic: retry only when the job was killed
        errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}
