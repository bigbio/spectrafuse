/*
    ID-based reduction of identified projects (e.g. MSNet): cluster every PSM of a project per charge with
    MaRaCluster, then write one reduced qpx psm file per project (pyspectrafuse reduce-psm). The cluster DB
    and MSP library are not built. Put each project's .psm.parquet file(s) (parts allowed) in
    <parquet_dir>/<project>/.
*/
params {
    skip_instrument = true
    skip_cluster_db = true
    skip_msp        = true
    reduce_psm      = true
    cluster_max_psms_per_pfz = 2000
}

process {
    withName: '.*PARQUET_TO_DAT' {
        memory     = { check_max(32.GB * task.attempt, 'memory') }
        maxRetries = 3
    }
    withName: '.*RUN_MARACLUSTER_DAT' {
        memory     = { check_max(16.GB * (2 ** (task.attempt - 1)), 'memory') }
        maxRetries = 4
    }
    withName: '.*MERGE_MZ_WINDOWS' {
        memory = { check_max(64.GB * task.attempt, 'memory') }
        cpus   = { check_max(8, 'cpus') }
    }
    withName: '.*REDUCE_PSM' {
        memory        = { check_max(120.GB * task.attempt, 'memory') }
        cpus          = { check_max(16, 'cpus') }
        time          = { check_max(24.h * task.attempt, 'time') }
        // input checks are deterministic: retry only when killed
        errorStrategy = { task.exitStatus in (130..145) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}
